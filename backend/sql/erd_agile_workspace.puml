users ||--o{ oauth_accounts : "liên kết OAuth2"
users ||--o{ password_reset_tokens : "đặt lại mật khẩu"

' 2. Projects & Members
users ||--o{ projects : "sở hữu (owner_id)"
projects ||--o{ project_members : "có thành viên"
users ||--o{ project_members : "tham gia"
projects ||--o{ project_invitations : "phát hành lời mời"
users |o--o{ project_invitations : "gửi (inviter_id)"
users |o--o{ project_invitations : "nhận (invitee_id)"

' 3. Kanban Lists, Labels & Tasks
projects ||--o{ lists : "chia cột trạng thái"
projects ||--o{ labels : "định nghĩa nhãn"
projects ||--o{ tasks : "chứa công việc"
lists ||--o{ tasks : "phân loại cột"
users ||--o{ tasks : "tạo (created_by)"

tasks ||--o{ task_assignees : "phân công"
users ||--o{ task_assignees : "đảm nhận"

tasks ||--o{ task_labels : "gắn nhãn"
labels ||--o{ task_labels : "áp dụng cho"

' 4. Checklist, Comments, Attachments, Notifications & Activity Logs
tasks ||--o{ checklist_items : "chia đầu việc con"
tasks ||--o{ comments : "có bình luận"
users ||--o{ comments : "viết bình luận"
