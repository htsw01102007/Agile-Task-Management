users ||--o{ attachments : "tải lên"

users ||--o{ notifications : "nhận thông báo"
projects |o--o{ notifications : "phát sinh từ"

projects ||--o{ activity_logs : "ghi nhật ký dự án"
tasks |o--o{ activity_logs : "ghi nhật ký việc"
users ||--o{ activity_logs : "thực hiện thao tác"

@enduml

